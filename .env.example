# App Configuration
PORT=4003
NODE_ENV=development
# Logging mode: verbose | traffic | cache | clean (comma-separated: e.g. traffic,cache)
LOGGING=verbose

# Optional Security API Key (leave empty for public / internal private network)
API_KEY=

# Moderation Toggles
MODERATION_ENABLED=true
MODERATION_TEXT_ENABLED=true
MODERATION_IMAGE_ENABLED=true

# Low-Resource Potato Server CPU & Thread Limits
MODERATION_CPU_THREADS=1

# Moderation Thresholds (0.0 to 1.0)
MODERATION_TEXT_THRESHOLD=0.45
MODERATION_IMAGE_THRESHOLD=0.50
MODERATION_PORN_THRESHOLD=0.40
MODERATION_HENTAI_THRESHOLD=0.40
MODERATION_SEXY_THRESHOLD=0.60
MODERATION_TOXIC_THRESHOLD=0.45
MODERATION_VIOLENCE_THRESHOLD=0.45

# Cache TTL (7 days in seconds = 604800)
MODERATION_CACHE_TTL_SEC=604800

# Models (Hugging Face ONNX format)
IMAGE_MODEL=onnx-community/nsfw-image-detector-ONNX
TEXT_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# Cache Directory for Weights
HF_HOME=./.cache
TRANSFORMERS_CACHE=./.cache

# Redis Cache (Optional - falls back to in-memory LRU cache if disabled or unreachable)
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=mod:

# Redis Sentinel (Optional)
REDIS_SENTINEL_NAME=mymaster
REDIS_SENTINELS= # (ip:port,ip:port,...)
REDIS_SENTINEL_PASSWORD=
REDIS_NAT_MAP=

# Redis TLS (Optional)
REDIS_TLS=false
REDIS_TLS_CA=
REDIS_TLS_CERT=
REDIS_TLS_KEY=
REDIS_TLS_REJECT_UNAUTHORIZED=true
